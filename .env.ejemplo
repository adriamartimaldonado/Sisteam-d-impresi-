# Copia este fichero a `.env` y rellena los valores reales. `.env` NO se versiona.
# (§15: ningun secreto en el repositorio; aqui solo van ejemplos.)

# ======================= CENTRAL =======================
# Cadena de conexion a PostgreSQL (la unica verdad, decision D1/D2).
DATABASE_URL=postgresql+psycopg2://etiquetas:CAMBIAME@localhost:5432/etiquetas

# Puerto donde escucha la API del central.
CENTRAL_HOST=0.0.0.0
CENTRAL_PORT=8000

# Sede por defecto (columna `sede` existe desde el dia 1, aunque hoy haya una sola).
SEDE_DEFECTO=nave1

# ======================= PUESTO ========================
# URL del central al que pregunta este puesto (los puestos nunca escuchan).
CENTRAL_URL=http://central.local:8000

# API key de ESTE puesto (rol `puesto`). Se guarda hasheada en el central.
PUESTO_API_KEY=CAMBIAME

# Identidad del puesto y su impresora.
PUESTO_NOMBRE=puesto-1
IMPRESORA_IP=192.168.0.100
IMPRESORA_PUERTO=9100
IMPRESORA_DPI=203
IMPRESORA_RFID=true

# Base local del puesto (SQLite, un solo proceso). No compartir por red (§9).
PUESTO_DB=./puesto.sqlite3

# Tamano de bloque al reclamar (§5: empezar en 10).
BLOQUE_RECLAMO=10
